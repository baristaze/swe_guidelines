{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baristaze/swe_guidelines/benchmark/schema/result.schema.json",
  "title": "Benchmark run result",
  "description": "What one benchmark run produced: the subject, every repeat, every judgement, and the summary.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "scenario",
    "runtime",
    "started_at",
    "finished_at",
    "guideline_sha",
    "target_sha",
    "subject",
    "repeats",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "enum": ["host", "container", "vm"] },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "guideline_sha": { "type": "string" },
    "target_sha": { "type": ["string", "null"] },
    "versions": {
      "description": "Every version that decides a score, each as a reference that resolves off the machine that ran it: the checkout, Claude Code as the runtime answers it, the image, the target and the expected findings by path and content hash, and what agentic judges read beside the output.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkout": {
          "type": "object",
          "required": ["commit", "plugin_version", "dirty", "dirty_paths", "dirty_sha256"],
          "additionalProperties": false,
          "properties": {
            "commit": { "type": "string" },
            "plugin_version": { "type": ["string", "null"] },
            "dirty": {
              "description": "Whether the checkout held changes no commit holds, in the paths that decide a score; null when it is not a git checkout.",
              "type": ["boolean", "null"]
            },
            "dirty_paths": { "type": "array", "items": { "type": "string" } },
            "dirty_sha256": { "type": ["string", "null"] }
          }
        },
        "claude_code": {
          "description": "What `claude --version` answered inside the runtime; null when the subject runs no Claude Code or the runtime did not answer.",
          "type": ["string", "null"]
        },
        "image": {
          "description": "The container image by name and by the id the engine gives it; null outside the container runtime.",
          "type": ["object", "null"],
          "required": ["name", "id"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "id": { "type": ["string", "null"] }
          }
        },
        "target": { "$ref": "#/$defs/content" },
        "expected": { "$ref": "#/$defs/content" },
        "references": {
          "description": "Each reference agentic judges read, by name: paths of the checkout with one hash over them, or a public repository at a tag with the commit it names and the guideline release it pins.",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": ["source", "paths", "sha256"],
                "additionalProperties": false,
                "properties": {
                  "source": { "const": "checkout" },
                  "paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              },
              {
                "type": "object",
                "required": ["source", "url", "tag", "commit", "pins"],
                "additionalProperties": false,
                "properties": {
                  "source": { "const": "repository" },
                  "url": { "type": "string" },
                  "tag": { "type": "string" },
                  "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
                  "pins": { "description": "The guideline release the repository pins; null when it names none.", "type": ["string", "null"] }
                }
              }
            ]
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "rehearsal": {
      "description": "A rehearsal's outcome: completed, capped when the run's spend cap kept a phase from running, failed when the subject failed, or incomplete when a step it exists to prove did not happen, each such step named under missing; its spend cap, what it spent, and where the money went, each phase and each judge in the order they spent it. Only a rehearsal has it.",
      "type": "object",
      "required": ["status", "missing", "max_spend_usd", "spent_usd", "spent"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["completed", "capped", "failed", "incomplete"] },
        "missing": { "type": "array", "items": { "type": "string" } },
        "max_spend_usd": { "type": "number", "exclusiveMinimum": 0 },
        "spent_usd": { "type": "number", "minimum": 0 },
        "spent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["what", "usd"],
            "additionalProperties": false,
            "properties": {
              "what": { "type": "string" },
              "usd": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "source": {
      "description": "The run whose archived output this run judged again, with no subject run: that run's folder by name and path, the repeats judged, each repeat refused with why, the repeats the run's spend cap kept from being judged, and the groups each repeat's rubric took. Only a run that judges another run's output again has it.",
      "type": "object",
      "required": ["run_id", "path", "repeats", "refused", "capped"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "repeats": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "refused": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repeat", "reason"],
            "additionalProperties": false,
            "properties": {
              "repeat": { "type": "integer", "minimum": 0 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "capped": {
          "description": "The repeats with an archive that the run's spend cap kept from being judged: what was left of it did not cover their judges' budgets.",
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "rubric_groups": {
          "description": "For each repeat judged, the groups its rubric took: those the source run took with a phase that ran in that repeat. Only a scenario that declares groups has it.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repeat", "groups"],
            "additionalProperties": false,
            "properties": {
              "repeat": { "type": "integer", "minimum": 0 },
              "groups": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "spend": {
      "description": "What the run spent: tokens and US dollars per judge, for the subject, and in all. A model with no price is named under unpriced, and its cost is not in any figure.",
      "type": "object",
      "required": ["judges", "subject", "total_usd", "unpriced"],
      "additionalProperties": false,
      "properties": {
        "judges": { "type": "object", "additionalProperties": { "$ref": "#/$defs/spent" } },
        "subject": { "$ref": "#/$defs/spent" },
        "total_usd": { "type": "number", "minimum": 0 },
        "unpriced": { "type": "array", "items": { "type": "string" } }
      }
    },
    "subject": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["skill", "command", "qa"] },
        "skill": { "type": ["string", "null"] },
        "prompt": { "type": "string" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "model": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] },
        "plugin": { "type": ["string", "null"] },
        "max_turns": {
          "description": "A skill subject's turn cap when the scenario names one; null when it names none, as a turn count is no bound.",
          "type": ["integer", "null"]
        },
        "allowed_tools": { "type": "array", "items": { "type": "string" } },
        "max_usd": {
          "description": "A skill subject's spend cap in US dollars, passed to Claude Code as --max-budget-usd; null for a subject in phases, whose phases name their own.",
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "output": {
          "description": "The folder of the workspace a skill subject builds, committed after every phase and archived at the end; null when it builds none.",
          "type": ["string", "null"]
        },
        "gates": {
          "description": "The commands the harness runs in the output folder on the final tree, and counts as gate runs in each phase's stream.",
          "type": "array",
          "items": { "type": "string" }
        },
        "phases": {
          "description": "A subject in phases: each phase as the scenario declares it.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "prompt", "session", "cwd", "hint", "max_turns", "max_usd", "timeout_s", "max_gate_reruns", "on_cap"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "prompt": { "type": "string" },
              "session": { "type": "string", "enum": ["fresh", "resume"] },
              "cwd": { "type": "string", "enum": ["workspace", "output"] },
              "hint": { "type": "boolean" },
              "max_turns": { "description": "The phase's turn cap when it names one; null when it names none.", "type": ["integer", "null"], "minimum": 1 },
              "max_usd": { "type": "number", "exclusiveMinimum": 0 },
              "timeout_s": { "type": "integer", "minimum": 1 },
              "max_gate_reruns": { "type": "integer", "minimum": 0 },
              "on_cap": { "type": "string", "enum": ["continue", "stop"] },
              "group": {
                "description": "The optional group the phase belongs to; null for a phase every run takes.",
                "type": ["string", "null"]
              }
            }
          }
        },
        "groups": {
          "description": "The optional groups of phases the run took, by --with, in the scenario's order; present when the scenario declares any, and empty for a run that took none.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "repeats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "exit_status", "artifact_paths", "judgements"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "exit_status": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": { "type": "integer" },
              "signal": { "type": ["integer", "null"] },
              "duration_s": { "type": "number" },
              "timed_out": { "type": "boolean" },
              "is_error": { "type": "boolean" },
              "stopped": { "description": "The harness stopped the subject at a bound before it ended.", "type": "boolean" }
            }
          },
          "artifact_paths": { "type": "array", "items": { "type": "string" } },
          "phases": {
            "description": "A skill subject's sessions, in order: how each ended, the bound that ended it, its turns, and what it spent. Only the phases that ran.",
            "type": "array",
            "items": { "$ref": "#/$defs/phase" }
          },
          "cut_short": {
            "description": "The phases the run's spend cap kept from running. Such a repeat is not judged and is in no mean.",
            "type": "array",
            "items": { "type": "string" }
          },
          "ended_early": {
            "description": "The phase that ended the run early, and the phases after it, which did not run. The reason is no_tree, the output folder held no file after it, or incomplete, its session ended with an Agent call unanswered. Such a repeat failed: it is not judged, it scores 0, and the run ends with it.",
            "type": "object",
            "required": ["phase", "reason", "not_run"],
            "additionalProperties": false,
            "properties": {
              "phase": { "type": "string" },
              "reason": { "type": "string", "enum": ["no_tree", "incomplete"] },
              "not_run": { "type": "array", "items": { "type": "string" } }
            }
          },
          "archive": {
            "description": "The output's last commit as a zip: its path and its manifest's in the run folder, its SHA-256, its size, how many files it holds, and the commit.",
            "type": "object",
            "required": ["path", "manifest", "sha256", "bytes", "files"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "manifest": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 },
              "files": { "type": "integer", "minimum": 0 },
              "commit": { "type": ["string", "null"] }
            }
          },
          "gates": {
            "description": "The scenario's gates, run on the final tree after the last phase; recorded beside the scores, never a cap on them.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["command", "passed", "exit_code"],
              "additionalProperties": false,
              "properties": {
                "command": { "type": "string" },
                "passed": { "type": "boolean" },
                "exit_code": { "type": "integer" },
                "timed_out": { "type": "boolean" },
                "duration_s": { "type": "number", "minimum": 0 }
              }
            }
          },
          "subject_models": {
            "description": "The models the subject's result reports it ran on.",
            "type": "array",
            "items": { "type": "string" }
          },
          "subject_usage": {
            "description": "The subject's tokens: input_tokens counts every input token, cached or not; output_tokens includes the reasoning.",
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "subject_cost_usd": {
            "description": "The subject's cost in US dollars: Claude Code's own figure for a skill, the list price for a qa answer; null when unknown.",
            "type": ["number", "null"],
            "minimum": 0
          },
          "expected": {
            "description": "Which planted findings the artifact names by lens id and file; present only when the scenario plants some.",
            "type": "object",
            "required": ["expected", "named", "missed"],
            "additionalProperties": false,
            "properties": {
              "expected": { "type": "integer", "minimum": 0 },
              "named": { "type": "array", "items": { "type": "string" } },
              "missed": { "type": "array", "items": { "type": "string" } }
            }
          },
          "judgements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["provider", "model", "effort", "status", "latency_s", "verdict"],
              "additionalProperties": false,
              "properties": {
                "provider": { "type": "string", "enum": ["anthropic", "openai", "gemini", "xai"] },
                "model": { "type": "string" },
                "effort": { "type": "string" },
                "status": { "type": "string", "enum": ["ok", "skipped", "error", "missed"] },
                "latency_s": { "type": "number", "minimum": 0 },
                "usage": {
                  "description": "input_tokens, output_tokens with the reasoning included, and reasoning_tokens when the provider reports it.",
                  "type": "object",
                  "additionalProperties": { "type": "integer" }
                },
                "cost_usd": {
                  "description": "The usage at the matrix's list price; null when the model has no price.",
                  "type": ["number", "null"],
                  "minimum": 0
                },
                "error": { "type": ["string", "null"] },
                "fallback": {
                  "description": "The model the matrix put first and why it did not answer, when a later model answered in its place.",
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["from", "reason"],
                      "additionalProperties": false,
                      "properties": {
                        "from": { "type": "string" },
                        "reason": { "type": "string" }
                      }
                    }
                  ]
                },
                "judged": {
                  "description": "An agentic judgement: each reference's weight, score, gaps, and strengths, the weighted score the harness computed, the rationale, what the loop spent in calls and turns, and the transcript's path in the run folder.",
                  "type": "object",
                  "required": ["score", "references", "rationale", "tool_calls", "turns", "transcript"],
                  "additionalProperties": false,
                  "properties": {
                    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                    "references": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "required": ["weight", "score", "gaps", "strengths"],
                        "additionalProperties": false,
                        "properties": {
                          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                          "gaps": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": ["severity", "what", "in_output", "in_reference"],
                              "additionalProperties": false,
                              "properties": {
                                "severity": { "type": "string", "enum": ["high", "medium", "low"] },
                                "what": { "type": "string" },
                                "in_output": { "type": "string" },
                                "in_reference": { "type": "string" },
                                "lens": { "type": "string" },
                                "fix": { "type": "string" }
                              }
                            }
                          },
                          "strengths": { "type": "array", "items": { "type": "string" } }
                        }
                      }
                    },
                    "rationale": { "type": "string" },
                    "tool_calls": { "type": "integer", "minimum": 0 },
                    "turns": { "type": "integer", "minimum": 0 },
                    "transcript": { "type": "string" }
                  }
                },
                "verdict": {
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["score", "verdict", "findings", "strengths", "rationale"],
                      "additionalProperties": false,
                      "properties": {
                        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                        "verdict": { "type": "string", "enum": ["pass", "weak", "fail"] },
                        "findings": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["severity", "note"],
                            "additionalProperties": false,
                            "properties": {
                              "severity": { "type": "string" },
                              "note": { "type": "string" }
                            }
                          }
                        },
                        "strengths": { "type": "array", "items": { "type": "string" } },
                        "rationale": { "type": "string" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["per_provider", "overall_mean", "skipped"],
      "additionalProperties": false,
      "properties": {
        "per_provider": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["mean", "min", "max", "n", "stdev"],
            "additionalProperties": false,
            "properties": {
              "mean": { "type": "number" },
              "min": { "description": "A verdict's score is whole; a weighted score has one decimal place.", "type": "number" },
              "max": { "type": "number" },
              "n": { "type": "integer", "minimum": 0 },
              "stdev": { "type": ["number", "null"] }
            }
          }
        },
        "overall_mean": { "type": ["number", "null"] },
        "references": {
          "description": "For agentic judges, each reference in the scenario's order: its weight, each provider's mean, the mean of those means, the range and count of its scores, a failed repeat as 0, and its gaps by severity.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["weight", "mean", "per_provider", "min", "max", "n", "gaps"],
            "additionalProperties": false,
            "properties": {
              "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "mean": { "type": ["number", "null"] },
              "per_provider": { "type": "object", "additionalProperties": { "type": "number" } },
              "min": { "type": ["integer", "null"] },
              "max": { "type": ["integer", "null"] },
              "n": { "type": "integer", "minimum": 0 },
              "gaps": {
                "type": "object",
                "required": ["high", "medium", "low"],
                "additionalProperties": false,
                "properties": {
                  "high": { "type": "integer", "minimum": 0 },
                  "medium": { "type": "integer", "minimum": 0 },
                  "low": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "cut_short": {
          "description": "The repeats the run's spend cap cut short; none is judged or in a mean.",
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "failed_repeats": {
          "description": "The repeats whose subject failed; each scores 0 in every provider's mean.",
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "spread": {
          "description": "Each scored repeat's mean over its providers, a failed repeat as 0, and their range and standard deviation.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["repeat_means", "min", "max", "stdev"],
              "additionalProperties": false,
              "properties": {
                "repeat_means": { "type": "array", "items": { "type": "number" } },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "stdev": { "type": ["number", "null"] }
              }
            }
          ]
        },
        "self_judged": {
          "description": "Set when a Claude subject is judged by a panel that scores with Claude.",
          "type": ["string", "null"]
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "reason"],
            "additionalProperties": false,
            "properties": {
              "provider": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "from", "to", "count", "reason"],
            "additionalProperties": false,
            "properties": {
              "provider": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 },
              "reason": { "type": "string" }
            }
          }
        },
        "missed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "count", "reason"],
            "additionalProperties": false,
            "properties": {
              "provider": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["name", "session", "status", "capped"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "session": { "type": "string", "enum": ["fresh", "resume"] },
        "status": {
          "description": "How the session ended: ok, capped at a bound, failed, or incomplete, with an Agent call unanswered when its result came.",
          "type": "string",
          "enum": ["ok", "capped", "failed", "incomplete"]
        },
        "capped": {
          "description": "The bound that ended the session: spend, time, gate_reruns, or turns when the phase names a turn cap; null when none did.",
          "type": ["string", "null"],
          "enum": ["spend", "time", "gate_reruns", "turns", null]
        },
        "exit_status": { "type": "object" },
        "session_id": { "type": ["string", "null"] },
        "turns": { "type": ["integer", "null"], "minimum": 0 },
        "models": { "type": "array", "items": { "type": "string" } },
        "cost_usd": {
          "description": "What Claude Code says the session cost; for a resumed session, what it added to the session's running total; null when it wrote no result.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "estimated_usd": {
          "description": "What the harness priced the session's stream at, the figure it holds the spend cap by.",
          "type": "number",
          "minimum": 0
        },
        "model_cost_usd": {
          "description": "Each model the session used and its cost in US dollars, from Claude Code's modelUsage; for a resumed session, what each added. Absent when the result reports none.",
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "wall_s": {
          "description": "The session's wall time in seconds, from its start to its end; its checkpoint is not in it.",
          "type": "number",
          "minimum": 0
        },
        "unpriced": { "type": "array", "items": { "type": "string" } },
        "gate_runs": {
          "description": "Each gate's runs in the session, its failures, the runs whose outcome was not read, and whether its last read run failed.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["runs", "failed", "unread", "failing"],
            "additionalProperties": false,
            "properties": {
              "runs": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 0 },
              "unread": { "description": "Runs whose outcome is not the call's: the gate piped, or followed by ;, ||, or &.", "type": "integer", "minimum": 0 },
              "failing": { "type": "boolean" }
            }
          }
        },
        "checkpoint": { "description": "The commit made in the output folder after the phase; null when none was.", "type": ["string", "null"] },
        "pending_agents": {
          "description": "The Agent calls with no result when the session's result came: each call's id and what it was asked.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "additionalProperties": false,
            "properties": { "id": { "type": "string" }, "description": { "type": "string" } }
          }
        }
      }
    },
    "content": {
      "description": "A file or a folder by its path, relative to the repository when it is inside it, and the SHA-256 of its content.",
      "type": ["object", "null"],
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "spent": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "reasoning_tokens", "cost_usd", "unpriced"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "unpriced": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
