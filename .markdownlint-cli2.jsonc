{
  // markdownlint-cli2 configuration. Run with `make lint`.
  "config": {
    "default": true,
    // Prose is wrapped by hand; tables, code, and tree diagrams run long.
    "MD013": false,
    // Wide tables keep their pipes unaligned for the same reason.
    "MD060": false,
    // The guideline uses pandoc-style list indentation ("-   item").
    "MD007": false,
    "MD030": false,
    // Every code block, tree diagrams included, is fenced.
    "MD046": { "style": "fenced" },
    // Subsection titles may repeat under different sections.
    "MD024": { "siblings_only": true },
    // Mermaid nodes use <br/> for line breaks.
    "MD033": { "allowed_elements": ["br"] },
    // Fenced code in the guideline is written as "``` python" (space after the fence).
    "MD040": true,
    // Files that open with frontmatter or an import line have no H1.
    "MD041": false,
    // A Makefile snippet in a code block needs its tabs.
    "MD010": { "code_blocks": false }
  },
  // The same files scripts/_common.py leaves out of the repository's Markdown.
  "ignores": ["**/node_modules/**", ".git/**", "**/.claude/**", "**/.venv/**", "**/.pytest_cache/**", "benchmark/runs/**"]
}
