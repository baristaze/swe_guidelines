{
  "components": {
    "schemas": {
      "CredentialKind": {
        "enum": [
          "api_key",
          "auth_session_token",
          "login",
          "socket_ticket",
          "operator_token",
          "internal"
        ],
        "title": "CredentialKind",
        "type": "string"
      },
      "DeliveryReceivedView": {
        "description": "The delivery checked out and is queued; the provider stops retrying.",
        "properties": {
          "received": {
            "title": "Received",
            "type": "boolean"
          }
        },
        "required": [
          "received"
        ],
        "title": "DeliveryReceivedView",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "last_owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LastOwnerDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "stream": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StreamTruncatedDetail"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LastOwnerDetail": {
        "description": "What a `last_owner` refusal carries: every team org the person is the\nlast owner of, which they hand on or delete before their account goes.",
        "properties": {
          "orgs": {
            "items": {
              "$ref": "#/components/schemas/OwnedOrgRef"
            },
            "title": "Orgs",
            "type": "array"
          }
        },
        "required": [
          "orgs"
        ],
        "title": "LastOwnerDetail",
        "type": "object"
      },
      "OperatorRole": {
        "description": "What an allowlist entry lets an operator do across every tenant. Write\nincludes read; the tenancy namespace's table says which permissions each\nrole holds, as it does for `Role`.",
        "enum": [
          "read",
          "write"
        ],
        "title": "OperatorRole",
        "type": "string"
      },
      "OwnedOrgRef": {
        "description": "An org named in a refusal: enough to find it and to say which.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ],
        "title": "OwnedOrgRef",
        "type": "object"
      },
      "Permission": {
        "enum": [
          "read",
          "write",
          "manage_members",
          "manage_keys"
        ],
        "title": "Permission",
        "type": "string"
      },
      "Role": {
        "enum": [
          "owner",
          "admin",
          "member",
          "viewer",
          "service"
        ],
        "title": "Role",
        "type": "string"
      },
      "StreamTruncatedDetail": {
        "description": "What a `stream_truncated` refusal carries: the floor, the highest seq\ntrimmed from the stream, and the head. A client drops its cursor, reads\nafresh what it shows, and goes on from the head.",
        "properties": {
          "floor": {
            "title": "Floor",
            "type": "integer"
          },
          "head": {
            "title": "Head",
            "type": "integer"
          }
        },
        "required": [
          "floor",
          "head"
        ],
        "title": "StreamTruncatedDetail",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: common",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {}
}
