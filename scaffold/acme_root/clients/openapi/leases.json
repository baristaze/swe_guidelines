{
  "components": {
    "schemas": {
      "AskRequest": {
        "additionalProperties": false,
        "description": "An ask for a lease: one resource by its id, or a selector, the labels\na resource of `kind` must offer. `payload` is in the shape the kind\nfixes; the term is bounded by the resource's, and the ask expires in line\nafter `wait_seconds`. When the grant starts a job, `start_seconds` is the\nwindow the job has to start in, bounded the same way; none gives it the\nterm.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/LeasableResourceKind"
          },
          "labels": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                  "type": "string"
                },
                "maxItems": 160,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Labels"
          },
          "leasable_resource_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leasable Resource Id"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "start_seconds": {
            "anyOf": [
              {
                "maximum": 604800.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Seconds"
          },
          "term_seconds": {
            "default": 60,
            "maximum": 604800.0,
            "minimum": 1.0,
            "title": "Term Seconds",
            "type": "integer"
          },
          "wait_seconds": {
            "default": 3600,
            "maximum": 604800.0,
            "minimum": 1.0,
            "title": "Wait Seconds",
            "type": "integer"
          }
        },
        "required": [
          "kind"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "EndReason": {
        "description": "Why a request left its line without a lease.",
        "enum": [
          "asked",
          "waiter_gone",
          "refused",
          "retired"
        ],
        "title": "EndReason",
        "type": "string"
      },
      "LeasableResourceKind": {
        "description": "A product adds its kinds here, each with the shape of what its ask\ncarries (`ASK_PAYLOADS`) and its hooks (`LeasableResourceKindInterface`).",
        "enum": [
          "noop"
        ],
        "title": "LeasableResourceKind",
        "type": "string"
      },
      "LeasableResourceView": {
        "description": "A resource and its anchor: the highest token granted on it, and the\nlease that holds it until when.",
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "fencing_token": {
            "title": "Fencing Token",
            "type": "integer"
          },
          "held_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Held Until"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/LeasableResourceKind"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "lease_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lease Id"
          },
          "max_term_seconds": {
            "title": "Max Term Seconds",
            "type": "integer"
          },
          "ref_id": {
            "format": "uuid",
            "title": "Ref Id",
            "type": "string"
          },
          "retired_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retired At"
          }
        },
        "required": [
          "id",
          "kind",
          "ref_id",
          "labels",
          "max_term_seconds",
          "available",
          "retired_at",
          "fencing_token",
          "lease_id",
          "held_until",
          "created_at"
        ],
        "title": "LeasableResourceView",
        "type": "object"
      },
      "LeaseEntryView": {
        "description": "One lease of a history, with the request it answered; none when the\nrequest was purged first.",
        "properties": {
          "lease": {
            "$ref": "#/components/schemas/LeaseView"
          },
          "request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LeaseRequestView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "lease",
          "request"
        ],
        "title": "LeaseEntryView",
        "type": "object"
      },
      "LeasePageView": {
        "description": "One page of a history, newest first. `next_cursor` fetches the next\npage and is null on the last one.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LeaseEntryView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "LeasePageView",
        "type": "object"
      },
      "LeaseRequestView": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "end_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EndReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/LeasableResourceKind"
          },
          "labels": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Labels"
          },
          "leasable_resource_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leasable Resource Id"
          },
          "lease_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lease Id"
          },
          "rank": {
            "title": "Rank",
            "type": "number"
          },
          "start_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Seconds"
          },
          "status": {
            "$ref": "#/components/schemas/RequestStatus"
          },
          "term_seconds": {
            "title": "Term Seconds",
            "type": "integer"
          },
          "wait_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wait Until"
          },
          "waiter_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waiter Id"
          },
          "waiter_kind": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WaiterKind"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "leasable_resource_id",
          "labels",
          "waiter_kind",
          "waiter_id",
          "term_seconds",
          "start_seconds",
          "wait_until",
          "rank",
          "status",
          "end_reason",
          "lease_id",
          "created_at",
          "created_by"
        ],
        "title": "LeaseRequestView",
        "type": "object"
      },
      "LeaseStatus": {
        "enum": [
          "active",
          "released",
          "expired",
          "revoked"
        ],
        "title": "LeaseStatus",
        "type": "string"
      },
      "LeaseView": {
        "description": "One grant: the holder acts on the resource under `fencing_token` until\nit has used `expires_in_seconds`, counted from when it asked. The token is\nno secret: it is the number the resource's own side refuses to go below.\nA grant that started a job shows when the job started, and until then\nexpires at the end of the window the job has to start in.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "expires_in_seconds": {
            "title": "Expires In Seconds",
            "type": "number"
          },
          "fencing_token": {
            "title": "Fencing Token",
            "type": "integer"
          },
          "holder_id": {
            "format": "uuid",
            "title": "Holder Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "leasable_resource_id": {
            "format": "uuid",
            "title": "Leasable Resource Id",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/LeaseStatus"
          },
          "term_seconds": {
            "title": "Term Seconds",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "leasable_resource_id",
          "request_id",
          "holder_id",
          "fencing_token",
          "term_seconds",
          "expires_at",
          "expires_in_seconds",
          "status",
          "ended_at",
          "started_at",
          "created_at"
        ],
        "title": "LeaseView",
        "type": "object"
      },
      "PlaceView": {
        "description": "A waiting request's place (1 is next in some line it stands in) and\nthe estimate of its wait in seconds, as its standing answers them.",
        "properties": {
          "estimate_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimate Seconds"
          },
          "place": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "place",
          "estimate_seconds"
        ],
        "title": "PlaceView",
        "type": "object"
      },
      "RenewRequest": {
        "additionalProperties": false,
        "description": "A renewal: the lease runs `seconds` from now, within the resource's\nbound, or its term again when it names none.",
        "properties": {
          "seconds": {
            "anyOf": [
              {
                "maximum": 604800.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seconds"
          }
        },
        "title": "RenewRequest",
        "type": "object"
      },
      "ReorderRequest": {
        "additionalProperties": false,
        "description": "Moves a waiting request in front of `before_id`, or to the end.",
        "properties": {
          "before_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Before Id"
          }
        },
        "title": "ReorderRequest",
        "type": "object"
      },
      "RequestStatus": {
        "enum": [
          "waiting",
          "granted",
          "cancelled",
          "expired"
        ],
        "title": "RequestStatus",
        "type": "string"
      },
      "StandingView": {
        "description": "Where a request stands: its lease once granted, or its place (1 is\nnext in some line it stands in) and an estimate of its wait in seconds,\nwhile it waits.",
        "properties": {
          "estimate_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimate Seconds"
          },
          "lease": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LeaseView"
              },
              {
                "type": "null"
              }
            ]
          },
          "place": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place"
          },
          "request": {
            "$ref": "#/components/schemas/LeaseRequestView"
          }
        },
        "required": [
          "request",
          "lease",
          "place",
          "estimate_seconds"
        ],
        "title": "StandingView",
        "type": "object"
      },
      "WaitLineView": {
        "description": "A leasable resource and the requests in its wait line, first first, with\neach one's place and estimate in the same order.",
        "properties": {
          "leasable_resource": {
            "$ref": "#/components/schemas/LeasableResourceView"
          },
          "places": {
            "items": {
              "$ref": "#/components/schemas/PlaceView"
            },
            "title": "Places",
            "type": "array"
          },
          "requests": {
            "items": {
              "$ref": "#/components/schemas/LeaseRequestView"
            },
            "title": "Requests",
            "type": "array"
          }
        },
        "required": [
          "leasable_resource",
          "requests",
          "places"
        ],
        "title": "WaitLineView",
        "type": "object"
      },
      "WaiterKind": {
        "description": "What waits on a request, so a grant wakes it. A product adds its own,\neach with a `WaiterInterface`.",
        "enum": [
          "orchestration"
        ],
        "title": "WaiterKind",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Acme API: leases",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/leases": {
      "get": {
        "description": "The history: the org's leases, or one resource's, newest first, ended\nones included, each with the request it answered, a page at a time.",
        "operationId": "list_leases",
        "parameters": [
          {
            "in": "query",
            "name": "leasable_resource_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Leasable Resource Id"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeasePageView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Leases",
        "tags": [
          "leases"
        ]
      }
    },
    "/v1/leases/leasable-resources/{leasable_resource_id}/wait-line": {
      "get": {
        "operationId": "wait_line",
        "parameters": [
          {
            "in": "path",
            "name": "leasable_resource_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Leasable Resource Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitLineView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Wait Line",
        "tags": [
          "leases"
        ]
      }
    },
    "/v1/leases/requests": {
      "post": {
        "description": "Joins the line, last; granted at once only when no one waits in front.\nThe resource's kind may refuse the ask first: 403 for who asks, 422 for\nwhat it asks. A replay answers what the first call saw: read the\nrequest for where it stands now.",
        "operationId": "ask",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandingView"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "not_authorized: the kind refuses this asker"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask",
        "tags": [
          "leases"
        ]
      }
    },
    "/v1/leases/requests/{request_id}": {
      "get": {
        "operationId": "get_request",
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Request Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
