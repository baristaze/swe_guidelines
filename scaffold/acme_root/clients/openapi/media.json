{
  "components": {
    "schemas": {
      "FilePageView": {
        "description": "One page of the org's stored files, oldest first. `next_cursor` fetches\nthe next page and is null on the last one.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FileView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "FilePageView",
        "type": "object"
      },
      "FilePurpose": {
        "description": "Which context a file came from. The purpose decides the bounds an\nupload is held to and what `subject_id` names. A product adds a purpose\nper kind of file it keeps, with its bounds (`media.rules.BOUNDS`).",
        "enum": [
          "upload"
        ],
        "title": "FilePurpose",
        "type": "string"
      },
      "FileStatus": {
        "enum": [
          "pending",
          "stored"
        ],
        "title": "FileStatus",
        "type": "string"
      },
      "FileView": {
        "description": "A file the tenant keeps: its name, type, and size, never its bytes and\nnever where they live. `status` is `pending` until the upload is\nconfirmed, then `stored`.",
        "properties": {
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "deleted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deleted At"
          },
          "extension": {
            "title": "Extension",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/FilePurpose"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/FileStatus"
          },
          "subject_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject Id"
          }
        },
        "required": [
          "id",
          "name",
          "extension",
          "content_type",
          "size_bytes",
          "purpose",
          "subject_id",
          "status",
          "created_at",
          "created_by",
          "deleted_at"
        ],
        "title": "FileView",
        "type": "object"
      },
      "IssuedDownloadView": {
        "description": "A link to the file's bytes that works until `expires_at`. A null `url`\nmeans the store cannot sign one: the bytes come from\n`GET /v1/media/files/{id}/content`.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "url",
          "expires_at"
        ],
        "title": "IssuedDownloadView",
        "type": "object"
      },
      "IssuedUploadView": {
        "description": "A form to post the file with, straight to the store: every field, in\norder, then the file as the last field, named `file`. The signed policy\nholds the post to the file's type and at most its size, until\n`expires_at`. A null `url` means the store cannot take a post: the bytes\ngo to `PUT /v1/media/files/{id}/content` instead. Then the upload is\nconfirmed.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/UploadFieldView"
            },
            "title": "Fields",
            "type": "array"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "url",
          "fields",
          "expires_at"
        ],
        "title": "IssuedUploadView",
        "type": "object"
      },
      "PurposeUsageView": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "pending_count": {
            "title": "Pending Count",
            "type": "integer"
          },
          "pending_size_bytes": {
            "title": "Pending Size Bytes",
            "type": "integer"
          },
          "purpose": {
            "$ref": "#/components/schemas/FilePurpose"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "purpose",
          "count",
          "size_bytes",
          "pending_count",
          "pending_size_bytes"
        ],
        "title": "PurposeUsageView",
        "type": "object"
      },
      "StartUploadRequest": {
        "additionalProperties": false,
        "description": "An upload to start: the file's name as the uploader had it, its type,\nand its size in bytes. The type must be one the purpose accepts and match\nthe name's extension; the size is the most the store will take.",
        "properties": {
          "content_type": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Content Type",
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "content_type",
          "size_bytes"
        ],
        "title": "StartUploadRequest",
        "type": "object"
      },
      "StorageUsageView": {
        "description": "What the org keeps in the store, counted from its files: the stored ones\nper purpose and in total, and the uploads started and not yet confirmed.\nA removed file stops counting at once.",
        "properties": {
          "pending_size_bytes": {
            "title": "Pending Size Bytes",
            "type": "integer"
          },
          "purposes": {
            "items": {
              "$ref": "#/components/schemas/PurposeUsageView"
            },
            "title": "Purposes",
            "type": "array"
          },
          "total_count": {
            "title": "Total Count",
            "type": "integer"
          },
          "total_size_bytes": {
            "title": "Total Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "purposes",
          "total_count",
          "total_size_bytes",
          "pending_size_bytes"
        ],
        "title": "StorageUsageView",
        "type": "object"
      },
      "UploadFieldView": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "title": "UploadFieldView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: media",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/media/files": {
      "get": {
        "description": "The org's stored files, oldest first; a pending upload is not listed.",
        "operationId": "list_files",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilePageView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Files",
        "tags": [
          "media"
        ]
      },
      "post": {
        "description": "A pending file, and nothing in the store yet: the upload form, the\nbytes, and the confirm follow by its id.",
        "operationId": "start_upload",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileView"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "feature_off: `media-uploads` is off"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Upload",
        "tags": [
          "media"
        ]
      }
    },
