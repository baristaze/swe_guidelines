# Every knob every Acme process reads, under the one product prefix ACME_.
# Copy to .env for local development; the compose stack matches these defaults.

# Environment name, one of: local, test, dev, staging, production. "local" and
# "test" allow the local backends below; the deployed names ("dev", "staging",
# "production", the same names deployment/terraform passes) refuse them at
# boot, and any other name is refused outright.
ACME_ENVIRONMENT=local

# The process's own name and version, as they appear in boot logs, traces,
# and the health response. Each binary has its own default (api, maintenance).
#ACME_SERVICE_NAME=api
#ACME_VERSION=0.7.0

# Storage. Three logins reach the database, and none is a superuser or
# carries BYPASSRLS: either one walks past every row-level security policy,
# and the policies are the second tenant fence.
# - The runtime login, ACME_DATABASE_URL: every request's connection. It
#   owns nothing and holds DML only.
# - The system login, ACME_DATABASE_SYSTEM_URL: the runtime login's twin
#   for the system scope, on a pool of its own. The policies admit the
#   system scope to it alone.
# - The migration login, ACME_DATABASE_MIGRATION_URL: owns the schema and
#   runs the migrations. Only the migrate command reads it.
# The master, ACME_DATABASE_MASTER_URL, opens one command,
# `migrate ensure-logins`, which makes the three with the passwords their
# URLs carry. Locally the superuser is `postgres`, the init script under
# deployment/local/ creates `acme` as the master, and `make migrate` runs
# ensure-logins first; in the cloud the master is RDS's.
# One URL serves every database role; a role moves to its own database by
# setting its own URL, and the system and migration logins follow it there.
ACME_DATABASE_URL=postgresql+asyncpg://acme_runtime:acme_runtime@127.0.0.1:55432/acme
ACME_DATABASE_SYSTEM_URL=postgresql+asyncpg://acme_system:acme_system@127.0.0.1:55432/acme
ACME_DATABASE_MIGRATION_URL=postgresql+asyncpg://acme_migration:acme_migration@127.0.0.1:55432/acme
ACME_DATABASE_MASTER_URL=postgresql+asyncpg://acme:acme@127.0.0.1:55432/acme
#ACME_DATABASE_URL_CORE=
#ACME_DATABASE_URL_ACTIVITY=
#ACME_DATABASE_URL_QUEUE=
#ACME_DATABASE_URL_ADMIN=
# Each role's pool declares its size, the bound on waiting for a connection,
# and the deadline every statement on it carries, so a saturated role fails
# the call that could not get a connection and a query that hangs costs one
# call and not a connection. The size is the whole pool (no overflow): four
# worker items holding a connection and a lease renewal each, plus the claim,
# the sweep, and the relay. The two bounds are seconds. Each knob has a
# per-role override that defaults to the shared value, the way a role URL
# does; a role that overrides one gets a pool of its own. The system login's
# pools run under the same bounds, beside the runtime login's.
ACME_DATABASE_POOL_SIZE=12
#ACME_DATABASE_POOL_SIZE_CORE=
#ACME_DATABASE_POOL_SIZE_ACTIVITY=
#ACME_DATABASE_POOL_SIZE_QUEUE=
#ACME_DATABASE_POOL_SIZE_ADMIN=
ACME_DATABASE_CHECKOUT_TIMEOUT_SECONDS=5
#ACME_DATABASE_CHECKOUT_TIMEOUT_SECONDS_CORE=
#ACME_DATABASE_CHECKOUT_TIMEOUT_SECONDS_ACTIVITY=
#ACME_DATABASE_CHECKOUT_TIMEOUT_SECONDS_QUEUE=
#ACME_DATABASE_CHECKOUT_TIMEOUT_SECONDS_ADMIN=
ACME_DATABASE_STATEMENT_TIMEOUT_SECONDS=10
#ACME_DATABASE_STATEMENT_TIMEOUT_SECONDS_CORE=
#ACME_DATABASE_STATEMENT_TIMEOUT_SECONDS_ACTIVITY=
#ACME_DATABASE_STATEMENT_TIMEOUT_SECONDS_QUEUE=
#ACME_DATABASE_STATEMENT_TIMEOUT_SECONDS_ADMIN=
# The longest a statement of the migrate command waits for a lock. A
# migration's DDL waits behind any transaction that holds its table, and the
# table's reads and writes queue behind the DDL meanwhile. Past the bound the
# command gives up, applies nothing of the role it was on, and exits 75,
# which the deploy's pre-rollout task runs again (ADR 0071). The migrate
# command's statements carry no deadline of their own. Seconds.
ACME_DATABASE_MIGRATION_LOCK_TIMEOUT_SECONDS=5

# Infra backends. memory|valkey, memory|valkey, local|s3, memory|sqs, local|aws.
ACME_CACHE_BACKEND=valkey
ACME_TOPICS_BACKEND=valkey
ACME_VALKEY_URL=valkey://127.0.0.1:56379/0
# The one breaker in front of Valkey, shared by the cache and the topic
# publisher, on the valkey backends only. A backend that is down answers every
# call with the whole of ACME_VALKEY_TIMEOUT_SECONDS, and the timeouts alone
# are what exhaust the pool. After this many calls in a row that spend the
# timeout, each answers at once for the cool-down, then one call goes through
# to decide whether to close. The answers never change: a cache that cannot be
# reached is a miss, and a topic is best effort.
ACME_VALKEY_BREAKER_FAILURES=3
ACME_VALKEY_BREAKER_COOLDOWN_SECONDS=30
ACME_BUCKETS_BACKEND=s3
ACME_BUCKETS_ROOT=.local/buckets
ACME_S3_ENDPOINT_URL=http://127.0.0.1:59000
# The address a browser reaches the store at, which a presigned upload or
# download URL names. Empty, it is ACME_S3_ENDPOINT_URL; the compose app
# containers reach MinIO as minio:9000 and set this to the host port.
ACME_S3_PRESIGN_ENDPOINT_URL=
ACME_S3_ACCESS_KEY=acme
ACME_S3_SECRET_KEY=acmeacme
# Bucket names are <prefix>-<bucket>: acme-user-file-uploads, acme-exports.
ACME_S3_BUCKET_PREFIX=acme
ACME_QUEUES_BACKEND=sqs
ACME_SQS_ENDPOINT_URL=http://127.0.0.1:59324
# Queue names are <prefix><queue>: acme-webhooks, acme-slack.
ACME_SQS_QUEUE_PREFIX=acme-
ACME_SECRETS_BACKEND=local
ACME_SECRETS_FILE=.local/secrets.env
# Secret names in the hosted store are <prefix><name>: acme/<name>.
ACME_SECRETS_NAME_PREFIX=acme/
ACME_AWS_REGION=us-east-1
# Every outbound call carries a timeout, one per client: the AWS clients
# (connect and read, per call), the Valkey client (per request), and the
# trace exporter (per batch). Seconds.
ACME_AWS_TIMEOUT_SECONDS=10
ACME_VALKEY_TIMEOUT_SECONDS=5
ACME_OTEL_TIMEOUT_SECONDS=10

# Local secrets. A secret belongs to a tenant. With ACME_SECRETS_BACKEND=local,
# ACME_SECRET_<ORG>_<NAME>=value, the org id in hex, overrides that tenant's
# entry <name> of the secrets file (org/<org id>/<name>); the settings object
# collects these once at boot, from this file and from the environment over
# it. Never set in a deployed environment.
#ACME_SECRET_0192F0C4A1B27D3E8F6A5B4C3D2E1F00_EXAMPLE_TOKEN=

# Observability. JSON logs in the cloud, readable logs locally; tracing only
# when an endpoint is set. Every JSON line names the service and the
# environment above, so one query reads across processes, its request, and the
# request that caused it where a handoff named one.
ACME_LOG_LEVEL=INFO
ACME_LOG_JSON=false
#ACME_OTEL_ENDPOINT=http://127.0.0.1:54318  # Jaeger in the devx profile
# Errors to GlitchTip in the devx profile (its seeded project, the local stand-in
# for the product's one tracker project); empty or "off" turns reporting off.
# Every event carries ACME_ENVIRONMENT above, which is what separates the
# environments inside one project, here and in the cloud.
ACME_SENTRY_DSN=http://0123456789abcdef0123456789abcdef@127.0.0.1:58000/1

# Billing: the payment processor. `twin` is a processor in memory, for tests
# and one process on a laptop (the api and the worker would each hold their
# own), and is refused outside local and test; `stripe` is the real one. With
# stripe and no key, billing is unconfigured: every org keeps its plan, and a
# checkout answers 503. docs/runbooks/providers/stripe.md has the local run.
ACME_BILLING_BACKEND=stripe
# The account every call names in Stripe-Context: here the Acme sandbox,
# test mode. Not a secret; each deployed environment commits its own.
ACME_STRIPE_ACCOUNT_ID=acct_1UIfVX45a2t9JoiY
# The runtime key: a restricted key of that account (rk_test_), with only the
# permissions docs/runbooks/providers/stripe.md lists for it. An organization
# key or a secret key is refused, and so is a live key outside production and
# a test key in it. Set it in .env or export it in the shell `make up` runs
# in, which the app containers take over .env; never commit one. The
# bootstrap's key, ACME_STRIPE_BOOTSTRAP_KEY, is never set here: the
# processes do not read it, and it lives only in the shell that runs
# `acme-ops stripe-bootstrap`.
#ACME_STRIPE_RUNTIME_KEY=
# The signing secret the processor signs its deliveries to this API with;
# locally, the `whsec_` that `stripe listen --forward-to
# http://127.0.0.1:8000/webhooks/stripe` prints. Set it the same way.
#ACME_STRIPE_WEBHOOK_SECRET=
# Every call to the processor is bounded by this. Seconds.
ACME_STRIPE_TIMEOUT_SECONDS=10
# How long an org's billing account is read from the cache before storage is
# asked again. A write of the account orphans the cached one at once; this is
# the longest a plan read stays stale when that fails (ADR 0066). The API and
# the worker both read it. Seconds, an hour at most.
ACME_BILLING_ACCOUNT_CACHE_SECONDS=60

# Slack: the app each org installs into its workspace. `twin` is Slack in
# memory, and is refused outside local and test: "Add to Slack" in the local
# portal installs into the twin's own workspace at once, and the worker posts
# to the twin, which logs each post. A laptop has no public URL, so Slack
# itself never calls it; a signed request to the local API stands in
# (docs/runbooks/providers/slack.md, Local development). `slack` is the real
# app, and with any of its three credentials unset Slack is unconfigured:
# "Add to Slack" and every call from Slack answer 503, and nothing is posted.
ACME_SLACK_BACKEND=twin
# The Slack app's client id, from its Basic Information page. Not a secret;
# each deployed environment commits its own app's.
#ACME_SLACK_CLIENT_ID=
# The app's client secret and signing secret, from the same page: the one
# trades an install's code for its token and renews tokens, the other checks
# every call Slack makes in. Left unset here, like the other provider keys:
# export them in the shell or set them in .env; never commit one.
#ACME_SLACK_CLIENT_SECRET=
#ACME_SLACK_SIGNING_SECRET=
# Each call to Slack is bounded by this. Seconds.
ACME_SLACK_TIMEOUT_SECONDS=10
# Where Slack sends a person's browser back at the end of an install: this
# API's /webhooks/slack/oauth. The app's manifest names the same URL.
ACME_SLACK_REDIRECT_URI=http://127.0.0.1:8000/webhooks/slack/oauth
# Where people open Acme: an install ends on its settings page, and a list
# answered in Slack links to it.
ACME_PORTAL_URL=http://localhost:55173

# API process.
ACME_HOST=127.0.0.1
ACME_PORT=8000
# The namespaces whose routers this process mounts, as a JSON list; empty
# mounts all of them (tenancy, tasks, events, media). A subset turns the same
# image into one namespace's service, e.g. ["media"], with no code change.
ACME_NAMESPACES=[]
ACME_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# The proxies whose X-Forwarded-For names the client (addresses or CIDR
# blocks; never "*", which would let any caller choose its own address for
# the login rate limit). Empty, the peer is the client; the cloud passes the
# VPC block the load balancer lives in, so the login rate limit counts per
# client there too.
ACME_TRUSTED_PROXIES=[]
# What the portal's CDN distribution sends in X-Acme-Edge: beside it, the
# viewer's address the edge appended to X-Forwarded-For names the client,
# one hop past the trusted proxies. The cloud's alone, injected from the
# secret store; unset here, where no edge stands in front.
#ACME_EDGE_SECRET=
ACME_LOGIN_RATE_LIMIT=2000
ACME_LOGIN_RATE_WINDOW_SECONDS=60
# Each session and each api key: a budget of reads (GET, HEAD) and one of
# writes over the window, counted in the cache and spent once the credential
# resolves. Sized for the busiest honest client; past it the answer is a 429
# with Retry-After. Fails open when the cache cannot count.
ACME_CREDENTIAL_RATE_LIMIT_READS=3000
ACME_CREDENTIAL_RATE_LIMIT_WRITES=1200
ACME_CREDENTIAL_RATE_WINDOW_SECONDS=60
# Each address: the bearers it may present that turn out unknown, expired, or
# revoked over the window. Once spent, its requests are refused with a 429
# before any credential is looked up. Fails open like the limits above.
ACME_FAILED_AUTHENTICATION_LIMIT=1000
ACME_FAILED_AUTHENTICATION_WINDOW_SECONDS=60
# Per email, in the database, beside the per-address limit above: the first
# wrong second-factor codes in a row cost nothing, then the next attempt
# waits, starting at the base and doubling up to the cap, whatever address it
# comes from. Seconds.
ACME_SIGN_IN_FREE_FAILURES=10
ACME_SIGN_IN_DELAY_BASE_SECONDS=1
ACME_SIGN_IN_DELAY_CAP_SECONDS=30
# How long a sign-in lasts before it is exchanged for a session, and how long
# a session lasts: from its exchange, and from its last use. It ends at
# whichever passes first: 30 days from its exchange, or 14 days without a
# request. Seconds.
ACME_LOGIN_LIFETIME_SECONDS=600
ACME_SESSION_LIFETIME_SECONDS=2592000
ACME_SESSION_IDLE_LIFETIME_SECONDS=1209600
# The longest an operator token lives, an hour at most. Seconds.
ACME_OPERATOR_TOKEN_MAX_LIFETIME_SECONDS=3600
# The key the operators' TOTP secrets are sealed under: a Fernet key,
# URL-safe base64 of 32 bytes. This one is for a developer's machine only;
# the cloud injects its own from the secret store, into the API alone.
ACME_TOTP_ENCRYPTION_KEY=YWNtZS1sb2NhbC10b3RwLWtleS1ub3QtYS1zZWNyZXQ=
# Sign-in. A person signs in through WorkOS AuthKit (an email code or
# link, Google, GitHub, or their org's single sign-on); a first sign-in is
# the sign-up. `workos`, `twin` (the in-process twin, local only), or `none`.
# The client id is the Acme App application's, not a secret; locally it is
# the staging environment's Acme App, which accepts the local callbacks.
ACME_IDENTITY_PROVIDER=workos
ACME_WORKOS_CLIENT_ID=client_STAGING_PLACEHOLDER
# The Acme App application's API key (Applications, Acme App, API keys),
# never the environment's: a secret, never committed. Export it in the shell
# (`make up` passes it to the API container) or set it in .env. Without it,
# a sign-in through WorkOS answers 503 and the local sign-in below still works.
# With a key that is not the application's, the API refuses to start.
#ACME_WORKOS_API_KEY=
# Where the WorkOS client calls, and the timeout every call is sent with.
# Whole seconds: the SDK takes no fraction, so one is rounded up.
#ACME_WORKOS_BASE_URL=https://api.workos.com
#ACME_WORKOS_TIMEOUT_SECONDS=10
# Where a sign-in may come back to: this environment's portal callback. The
# local stack's portal (nginx on 55173) and the Vite dev server (5173).
#ACME_SIGN_IN_REDIRECT_URIS=["http://localhost:55173/auth/callback","http://localhost:5173/auth/callback"]
# Where WorkOS's logout may send a person back to after the sign-out ends
# their AuthKit session: the portal's /signed-out on the same two ports. Each
# is also a sign-out URI on the Acme App's Redirects tab.
#ACME_SIGN_OUT_RETURN_URIS=["http://localhost:55173/signed-out","http://localhost:5173/signed-out"]
# The local sign-in by address alone, for the seed, the demos, the traffic
# generator, and the tests (POST /v1/auth/dev-sign-in, the portal's
# /login/dev). Refused at boot outside `local` and `test`.
ACME_DEV_SIGN_IN_ENABLED=true
# How long an invitation's link works, in days.
#ACME_INVITATION_LIFETIME_DAYS=7

# The interactive API docs (/docs, /redoc) and /openapi.json, for a developer.
# A deployed environment sets it false; the document is in the repository.
ACME_INTERACTIVE_DOCS=true
# The socket's two send lanes. The stream lane holds the event hints and a
# full one drops its oldest, which the client replays; the control lane holds
# the frames that say where the socket stands (hello, pong, subscribed,
# unsubscribed, error) and is small, because a lane that fills there is a
# fault and not a burst.
ACME_REALTIME_SEND_BUFFER_SIZE=256
ACME_REALTIME_CONTROL_BUFFER_SIZE=16
# How often an open socket asks again whether the credential behind it still
# holds. The bus closes a revoked socket at once; this is the bound when the
# bus lost the message. Seconds.
ACME_REALTIME_RECHECK_SECONDS=300
# How long the tenant's head heard on the bus answers a ping without a read:
# the longest a hint the bus lost stays hidden from a quiet socket. Zero
# reads the head on every ping. Seconds.
ACME_REALTIME_HEAD_MAX_AGE_SECONDS=60
# The readiness probe answers under a deadline of its own, shorter than the
# interval it is polled on: a timeout is a negative answer, never a missing
# one. Seconds.
ACME_READINESS_TIMEOUT_SECONDS=2
# Admission: the requests the process keeps in flight at once, one budget
# for reads (GET, HEAD) and one for writes, and the Retry-After a refusal
# past either carries. Two budgets, so a read storm cannot take every slot
# from the commands. Admission is the process defending itself and fails
# closed; the rate limits above are fairness between subjects and fail
# open. The health and metrics routes are outside both bounds.
ACME_ADMISSION_LIMIT_READS=400
ACME_ADMISSION_LIMIT_WRITES=200
ACME_ADMISSION_RETRY_AFTER_SECONDS=1
# The deadline of an admitted request, counted from when it takes its slot.
# Every call it makes to WorkOS, Stripe, Slack, or AWS shares it, and a call
# still waiting when it passes ends there with the answer a provider that
# does not answer gets (503 unavailable). It sits under the 30 seconds the
# portal and the command line wait for a call, and under the load
# balancer's 60. Seconds.
ACME_REQUEST_DEADLINE_SECONDS=20

# Maintenance worker.
#ACME_WORKER_ID=            # defaults to maintenance-<host>-<pid>
ACME_WORKER_LANE=default
ACME_WORKER_CAPACITY=4
ACME_WORKER_LEASE_SECONDS=60
ACME_WORKER_HEARTBEAT_SECONDS=10
ACME_WORKER_SWEEP_SECONDS=30
ACME_WORKER_POLL_SECONDS=5
# The sweep. A purge statement deletes this many rows at most, so none grows
# with a backlog past the statement deadline; the sweep calls again while a
# batch comes back full. A pass takes no new tenant once its budget is spent,
# and the next pass resumes at the tenant it stopped at. Rows, and seconds.
ACME_WORKER_PURGE_BATCH=1000
ACME_WORKER_SWEEP_BUDGET_SECONDS=20
# How often, in seconds, the sweep counts the platform's size into the tally
# the operator plane reads: a count across every tenant, so not every pass.
ACME_WORKER_TALLY_SECONDS=300
# How long each kind of row is kept after it stopped mattering, then purged.
# The outbox's outlives the database's backups (7 days), so a role restored
# to an earlier point is reconciled by relaying the outbox again. Tenancy's
# covers removed members, revoked keys, ended sessions, closed invitations,
# and a deleted tenant's rows. A socket ticket lives a minute.
ACME_OUTBOX_RETENTION_DAYS=8
ACME_WORK_RETENTION_DAYS=30
ACME_IDEMPOTENCY_RETENTION_HOURS=24
ACME_TENANCY_RETENTION_DAYS=30
ACME_SOCKET_TICKET_RETENTION_HOURS=24
ACME_SIGN_IN_DELAY_RETENTION_HOURS=720
ACME_TASKS_RETENTION_DAYS=30
ACME_MEDIA_RETENTION_DAYS=1
ACME_MEDIA_PENDING_EXPIRY_HOURS=24
ACME_BILLING_DELIVERY_RETENTION_DAYS=30
ACME_SLACK_RETENTION_DAYS=30
# How many days the sweep keeps a living org's events; it trims older ones
# from the bottom of the stream, a batch per org per call (ACME_WORKER_PURGE_BATCH). 0 keeps
# every event (docs/adr/0040-the-event-stream-has-a-floor.md).
ACME_EVENT_RETENTION_DAYS=90
# How long a received Slack call stays hidden while the worker handles it.
#ACME_SLACK_INBOUND_VISIBILITY_SECONDS=60
# A done task unchanged this many days is archived by the daily cleanup: it
# leaves the done list and can still be read and restored.
#ACME_TASKS_ARCHIVE_AFTER_DAYS=90
# The worker's /metrics, scraped in the devx profile: by Prometheus when the
# worker is a container, which binds 0.0.0.0 (docker-compose.full.yml sets
# it), and by the collector beside the host processes when it is one, which
# stays local. On Linux the Makefile puts that collector on the host's network
# (deployment/local/docker-compose.linux.yml) so it reaches 127.0.0.1.
#ACME_METRICS_HOST=127.0.0.1
ACME_METRICS_PORT=9464

# Developer dashboards (the compose devx profile): the host port each one
# listens on, 127.0.0.1 only. Change one here when it clashes; `make urls`
# and the compose stack read the same values. On Linux the collector writes
# to Prometheus through ACME_PROMETHEUS_PORT. GlitchTip's port is also in
# the DSNs above and in VITE_SENTRY_DSN below.
ACME_PGWEB_PORT=58081
ACME_VALKEY_ADMIN_PORT=58080
ACME_ELASTICMQ_UI_PORT=53000
ACME_JAEGER_PORT=56686
ACME_JAEGER_OTLP_PORT=54318
ACME_PROMETHEUS_PORT=59090
ACME_GRAFANA_PORT=53001
ACME_GLITCHTIP_PORT=58000

# The api's port as the devx collector scrapes it on the host: the api job
# has one target, and by default it is the port scripts/dev.sh binds. A run
# whose api is somewhere else points the collector at it and recreates the
# container with `make collector-scrape SCRAPE_PORT=<port>`; the telemetry
# round trip does that with the free port it takes, and puts this one back.
ACME_COLLECTOR_SCRAPE_PORT=8000

# The devx stores as the ops package reads them back (`acme-ops signals check
# --env local`, `make test-telemetry`): the same ports as above, as URLs. The
# token is the read-only GlitchTip API token glitchtip-seed creates, fixed the
# way the project key is; local only, like the DSN. A deployed environment
# names its own in ~/.config/acme/ops/<env>.env, never here.
#
# The org and the project are the product's one project in the tracker, the
# same value in every environment: a read names it and filters on the
# environment (`environment:local` here). Locally they are what
# glitchtip-seed creates, which is also what they default to.
ACME_PROMETHEUS_URL=http://localhost:59090
ACME_JAEGER_URL=http://localhost:56686
ACME_ERROR_TRACKER_URL=http://localhost:58000
ACME_ERROR_TRACKER_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACME_ERROR_TRACKER_ORG=acme
ACME_ERROR_TRACKER_PROJECT=acme

# The local people `make seed` creates, who sign in by address at the
# portal's /login/dev: an owner and a member of one org, so "My Tasks" and
# "Team's Tasks" differ. A third person,
# the admin, owns a second org and is an admin of the first, so the org picker
# and the org chip have two orgs to switch between. Override any of these here
# or on the command line, e.g. `make seed SEED_EMAIL=me@example.test`.
SEED_ORG=Ajax
SEED_SLUG=ajax
SEED_NAME=Local Owner
SEED_EMAIL=owner@example.test
SEED_MEMBER_NAME=Bob
SEED_MEMBER_EMAIL=bob@example.test
SEED_SECOND_ORG=Fabrikam
SEED_SECOND_SLUG=fabrikam
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@admin.test

# The command line. ACME_API_URL and ACME_TOKEN name the API and the
# credential; these three are what its client does with a call. The timeout
# bounds every call and the socket's open. The retry is the client's and the
# only one: a retryable failure gets this many extra attempts, the first after
# a wait of this base, which doubles and carries jitter. Zero retries sends
# every call exactly once.
#ACME_HTTP_TIMEOUT_SECONDS=30
#ACME_HTTP_RETRIES=2
#ACME_HTTP_RETRY_BACKOFF_SECONDS=0.25

# Portal (Vite reads VITE_ variables at build time). An empty VITE_API_URL
# means the page's own origin, as in the cloud: the dev server forwards /v1,
# the realtime socket included, to the API on 127.0.0.1:8000
# (ACME_PORTAL_API_TARGET names another), and so does the portal container.
VITE_API_URL=
VITE_SENTRY_DSN=http://0123456789abcdef0123456789abcdef@localhost:58000/1
